# Copy to .env and fill in. .env is gitignored; never commit it.

# Supabase — hosted project cornerstone-cloud, ap-south-1 (Mumbai)
SUPABASE_PROJECT_REF=
SUPABASE_URL=
DATABASE_URL=
# The publishable key (sb_publishable_...), from Supabase > Settings > API keys.
# Never the secret or service_role key: this one reaches the browser.
# Verify it before deploying:
#   curl -s -o /dev/null -w '%{http_code}
' -H "apikey: $SUPABASE_ANON_KEY" "$SUPABASE_URL/auth/v1/settings"
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Repo-scoped CLI token: dashboard > account > tokens, signed in as the school account.
# Needed because this machine's default Supabase login is a different account.
SUPABASE_ACCESS_TOKEN=

# Vision model for the pilot — aistudio.google.com, free tier (ADR 0004)
GEMINI_API_KEY=

# Optional: Claude, for the accuracy comparison on the gold set
ANTHROPIC_API_KEY=

# The single tenant for the pilot
TENANT_SLUG=cornerstone-pune
