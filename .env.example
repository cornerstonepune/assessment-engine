# Copy to .env and fill in. .env is gitignored; never commit it.

# Supabase — hosted project cornerstone-cloud, ap-south-1 (Mumbai)
SUPABASE_PROJECT_REF=
SUPABASE_URL=
DATABASE_URL=
# The local copy every test and goal run uses — bin/testdb builds it (ADR 0025). Never the live database.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# The publishable key (sb_publishable_...), from Supabase > Settings > API keys.
# Never the secret or service_role key: this one reaches the browser.
# Verify it authenticates before deploying: a GET on $SUPABASE_URL/auth/v1/settings
# with header 'apikey: <this key>' must return 200. A 401 means the key is wrong,
# and the only symptom in the app is 'the link could not be sent'.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Repo-scoped CLI token: dashboard > account > tokens, signed in as the school account.
# Needed because this machine's default Supabase login is a different account.
SUPABASE_ACCESS_TOKEN=

# Vision model for the pilot — aistudio.google.com, free tier (ADR 0004)
GEMINI_API_KEY=

# Optional: Claude, for the accuracy comparison on the gold set
ANTHROPIC_API_KEY=

# The single tenant for the pilot
TENANT_SLUG=cornerstone-pune

# The engine's own HTTP service (ADR 0008). n8n and any other caller send this as X-Engine-Key.
# Generate with: openssl rand -hex 32
ENGINE_KEY=
# Where the web app reaches the engine: the page images on the approval screen and the marking of
# a corrected reading both go through it. Default http://localhost:8000; set it when the engine
# runs elsewhere, or when something else on the machine already holds that port.
ENGINE_URL=http://localhost:8000

# n8n's own secret, for encrypting stored credentials (Drive OAuth, later). Generate the same way.
# Losing this after n8n has stored credentials means re-entering every one of them.
N8N_ENCRYPTION_KEY=
