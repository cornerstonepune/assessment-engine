#!/usr/bin/env bash
# Bring the live site up to what is merged on main, in the one safe order. From anywhere:
#   ~/cornerstone/assessment-engine/bin/update-live
#
# 1 main, pulled   2 new migrations onto the live database, before anything reads them
# 3 the engine server on that code (deploy/go-live.sh)   4 the seed rows (engine load)
# 5 every question's labels measured again, the old ladder's questions and papers moved onto the skills
#   (rehome places by those labels, so it comes after relabel), questions made by an old rule replaced,
#   worksheets rebuilt, each child's skills rebuilt from their answers (engine graph)
# 6 the checks, printed; `engine live data` fails the run when the rows and the pages disagree.
# Safe to run again: each step does nothing when there is nothing to do.
# --no-server skips step 3, for when Amazon cannot be reached: the database steps do not need the server.
# Needs what go-live.sh needs, plus DATABASE_URL in .env and the Supabase CLI.
set -euo pipefail

main() {
REPO="$(cd "$(dirname "$0")/.." && pwd)"
LIVE=$(grep -E '^DATABASE_URL=' "$REPO/.env" | cut -d= -f2- | tr -d "\"'")
E="$REPO/bin/engine"
say() { printf '\n==> %s\n' "$*"; }

say "1/6 main"
git -C "$REPO" checkout main && git -C "$REPO" pull --ff-only origin main
(cd "$REPO/packages/engine" && uv sync -q)

say "2/6 migrations onto the live database"
(cd "$REPO" && supabase db push --db-url "$LIVE" --yes)

say "3/6 the engine server"
if [ "${1:-}" = "--no-server" ]; then
  echo "skipped (--no-server): the server keeps the code it has; run this again without it to bring it up to date"
else
  "$REPO/deploy/go-live.sh"
fi

say "4/6 seed rows"
"$E" load
"$E" bank levels --apply   # load never rewrites a skill that exists; a changed level reaches it only here
for p in "$REPO"/supabase/seed/papers/*.json; do "$E" legacy paper "$p" >/dev/null; done   # old papers' levels, as their files now say

say "5/6 the bank, the worksheets, each child's skills"
"$E" bank relabel
"$E" bank rehome
"$E" bank refill
"$E" library build
"$E" graph

say "6/6 checks"
"$E" library check
"$E" bank taxonomy
"$E" audit || true   # prints what waits on a person (approvals, the guessable levels); see HANDOFF
"$E" live data
}

main "$@"
