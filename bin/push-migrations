#!/usr/bin/env bash
# The one way a migration reaches the live database. migrate live (.github/workflows/migrate.yml) and bin/update-live
# both run it, with live's connection string in LIVE:
#   LIVE=postgresql://… ~/cornerstone/assessment-engine/bin/push-migrations
#
# 2026-10-21 12:52 UTC, school in session: `create or replace view answer_checked`, a change to the catalogue only,
# waited 121 s for a lock live's readers of that view held, until live's 2-minute statement timeout cancelled it
# (SQLSTATE 57014); every educator's query on that view queued behind it meanwhile. A re-run at 13:25 took 14 s.
# So a migration gives up a lock it cannot have within 3 s (SQLSTATE 55P03; its transaction rolls back whole, nothing
# recorded), and this tries again shortly; any other failure stops at once. A migration that holds its locks and has
# real work to do gets 10 minutes, not live's 2.
# The settings are the first statements of each migration, inside the transaction `db push` runs it in, so they reach
# the backend that runs it. Given at connection start (PGOPTIONS) they did not: live is reached through Supabase's
# pooler, which does not pass startup options on (ADR 0024 measured the same), and on 2026-10-22 the check that read
# them back failed both times it ran (run 39709016021), holding the website with nothing to apply. The migration
# checks its own settings and fails, before any change, if they are not there (rehearsed: supabase 2.121.0, a reader
# holding the view, 55P03 after 3 s; docs/notes/l14b-timeouts-in-band.md).
# The migrations are rewritten in a folder of their own, never in the checkout: on a person's machine the checkout is
# main, which the next `git pull --ff-only` must find unchanged.
set -euo pipefail

read -r -d '' SETTINGS <<'SQL' || true   # `|| true`: read returns 1 at the end of its text
set lock_timeout = '3s'; set statement_timeout = '10min'; do $$ begin if current_setting('lock_timeout') <> '3s' or current_setting('statement_timeout') <> '10min' then raise exception 'this migration''s session did not take lock_timeout 3s and statement_timeout 10min'; end if; end $$;
SQL

: "${LIVE:?LIVE, the connection string of the live database, is not set; nothing was pushed}"
REPO="$(cd "$(dirname "$0")/.." && pwd)"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/supabase/migrations"
cp "$REPO/supabase/config.toml" "$work/supabase/"
for f in "$REPO"/supabase/migrations/*.sql; do
  { printf '%s\n' "$SETTINGS"; cat "$f"; } > "$work/supabase/migrations/${f##*/}"
done

for try in 1 2 3 4 5 6; do
  if out=$(supabase db push --workdir "$work" --db-url "$LIVE" --yes 2>&1); then echo "$out"; exit 0; fi
  echo "$out"
  # 55P03, a lock it could not have in 3 s; 40P01, a deadlock with a reader of live (2026-10-22 17:32, B4's migration
  # held one table and waited on another a reader held). Either way Postgres rolled the migration back whole.
  case "$out" in *55P03*|*40P01*) ;; *) exit 1 ;; esac
  echo "::warning::try $try of 6: a query on live held a lock the migration needs; trying again in 20 s"
  sleep 20
done
echo "::error::live stayed busy for six tries; run this again when it is quieter"
exit 1
