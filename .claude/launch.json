{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "apps/web",
      "port": 3000
    },
    {
      "name": "web (signed in)",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "AUTH_DEV_BYPASS=1 npm run dev"
      ],
      "cwd": "apps/web",
      "port": 3000
    }
  ]
}
