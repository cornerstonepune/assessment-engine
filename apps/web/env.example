# Copy to apps/web/.env.local (gitignored). Data comes from the repo-root .env's DATABASE_URL.

# Signs the staff session cookie. 32+ chars: openssl rand -hex 32
AUTH_SECRET=

# Development only, ignored in production: skip sign-in and act as "Dev bypass".
AUTH_DEV_BYPASS=0

# Sign in with Google (goals/a1-sign-in-with-google.yaml): the school Workspace's OAuth client, type Web application.
# Server-side only, never NEXT_PUBLIC_. Without both, the sign-in page says sign-in is not set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
