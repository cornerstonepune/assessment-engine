# Copy to apps/web/.env.local (gitignored). Data comes from the repo-root .env's DATABASE_URL;
# only sign-in needs these two, both from Supabase → Settings → API keys.
NEXT_PUBLIC_SUPABASE_URL=https://ruznbyngtfjsaymuylhm.supabase.co
# The publishable key (sb_publishable_...), from Supabase > Settings > API keys.
# Never the secret or service_role key: this one reaches the browser.
# Verify it before deploying:
#   curl -s -o /dev/null -w '%{http_code}
' -H "apikey: $NEXT_PUBLIC_SUPABASE_ANON_KEY" "$SUPABASE_URL/auth/v1/settings"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Where magic links return to, when not localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Development only, ignored in production: skip sign-in and act as "Dev bypass".
AUTH_DEV_BYPASS=0
